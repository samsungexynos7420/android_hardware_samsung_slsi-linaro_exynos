soong_namespace {}

cc_binary {
    name: "cbd",
    proprietary: true,
    static_executable: false,
 
    include_dirs: [
        "bionic/libc/bionic",
    ],
    
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE",
     ],

    srcs: [
        "main.c",
        "util.c",
        "boot_xmm626x.c",
        "boot_xmm72xx.c",
        "boot_xmm72xx_lli.c",
        "boot_cmc221.c",
        "boot_cbp72.c",
        "boot_esc6270.c",
        "hdlc.c",
        "std_boot.c",
        "boot_shannon.c",
        "boot_shannon_hsic.c",
        "boot_shannon333.c",
        "boot_shannon310.c",
        "boot_shannon5100.c",
        "util_srinfo.c"
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
    ],
}

cc_defaults {
    name: "cld",
    static_executable: false,
    proprietary: true,
    stem: "cld",

    include_dirs: ["bionic/libc/bionic"],

    srcs: ["lb_main.c"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libc",
    ],
}
